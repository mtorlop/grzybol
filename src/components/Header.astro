
---
const { activePage = 'start' } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<header class="header">
  <a
    class="logo"
    href={base}
    aria-label="Grzybol, strona główna"
  >
    <img
      src={`${base}assets/grzybol-logo.png`}
      alt="Grzybol, logo z satelitą"
    />
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
  >
    MENU ☰
  </button>

  <nav
    class="nav"
    id="main-nav"
    aria-label="Nawigacja główna"
  >
    <a
      href={base}
      aria-current={activePage === 'start' ? 'page' : undefined}
    >
      START
    </a>

    <a
      href={`${base}projekt/`}
      aria-current={activePage === 'projekt' ? 'page' : undefined}
    >
      O PROJEKCIE
    </a>

    <a
      href={`${base}devlog/`}
      aria-current={activePage === 'devlog' ? 'page' : undefined}
    >
      DEVLOG
    </a>

    <a
      href={`${base}roadmapa/`}
      aria-current={activePage === 'roadmapa' ? 'page' : undefined}
    >
      ROADMAPA
    </a>
  </nav>
</header>
