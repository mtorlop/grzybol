---
const base = import.meta.env.BASE_URL;
const logoBezOrbity = `${base}assets/grzybol-logo-bez-orbity.png`;
const logoOrbita = `${base}assets/grzybol-logo-orbita.png`;
---

<!-- Intro jest odtwarzane raz na karte, nie przy kazdej zmianie podstrony. -->
<script is:inline>
  try {
    const played = sessionStorage.getItem('grzybol-boot-orbit-v2') === '1';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!played && !reduced) {
      document.documentElement.classList.add('gb-boot-pending');
    }
  } catch {
    // Brak dostepu do pamieci sesji nie blokuje strony.
  }
</script>

<div id="gb-boot" aria-hidden="true">
  <pre id="gb-code"></pre>

  <div id="gb-logo-stage">
    <img class="gb-logo-main" src={logoBezOrbity} alt="" />
    <img class="gb-logo-slice gb-slice-top" src={logoBezOrbity} alt="" />
    <img class="gb-logo-slice gb-slice-middle" src={logoBezOrbity} alt="" />
    <img class="gb-logo-slice gb-slice-bottom" src={logoBezOrbity} alt="" />
    <!-- Pierwotny pierscien jest OSOBNA warstwa PNG. Rysujemy go maska SVG,
         dokladnie po jego oryginalnym ksztalcie, bez dodatkowej kropki. -->
    <svg class="gb-orbit" viewBox="0 0 818 261" aria-hidden="true" focusable="false">
      <defs>
        <mask id="gb-orbit-boot-mask" x="0" y="0" width="818" height="261"
              maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse">
          <!-- Gorny luk: od prawej do lewej. -->
          <path class="gb-orbit-draw gb-orbit-upper" pathLength="100"
                d="M 267 130 C 303 108 318 85 291 72 C 274 63 244 66 218 74" />
          <!-- Dolny luk: od lewej do prawej. -->
          <path class="gb-orbit-draw gb-orbit-lower" pathLength="100"
                d="M 128 118 C 73 151 56 188 106 190 C 141 192 192 174 230 158" />
        </mask>
      </defs>
      <image href={logoOrbita} x="0" y="0" width="818" height="261"
             mask="url(#gb-orbit-boot-mask)" />
    </svg>
  </div>
</div>

<style is:global>
  html.gb-boot-pending { overflow: hidden; }

  #gb-boot {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #020503;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 280ms ease, visibility 280ms;
  }

  html.gb-boot-pending #gb-boot {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Biale linijki kodu, od samego lewego gornego rogu. */
  #gb-code {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 8px 10px;
    overflow: hidden;
    color: #f5f5f1;
    opacity: 0.94;
    white-space: pre;
    font: clamp(10px, 1vw, 14px)/1.4 'Courier New', monospace;
    letter-spacing: 0.2px;
    text-shadow: 0 0 4px rgba(255,255,255,0.18);
    transition: opacity 100ms linear, filter 100ms linear;
  }

  #gb-boot.show-logo #gb-code {
    opacity: 0;
    filter: blur(3px);
  }

  #gb-logo-stage {
    position: relative;
    isolation: isolate;
    width: min(470px, 78vw);
    max-height: 50vh;
    opacity: 0;
  }

  #gb-logo-stage img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  #gb-logo-stage .gb-logo-main { position: relative; }

  #gb-logo-stage .gb-logo-slice {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  #gb-logo-stage .gb-slice-top {
    clip-path: inset(0 0 67% 0);
    filter: drop-shadow(3px 0 1px rgba(183,220,177,0.85));
  }

  #gb-logo-stage .gb-slice-middle {
    clip-path: inset(33% 0 33% 0);
    filter: drop-shadow(-3px 0 1px rgba(246,247,245,0.95));
  }

  #gb-logo-stage .gb-slice-bottom {
    clip-path: inset(67% 0 0 0);
    filter: drop-shadow(4px 0 1px rgba(218,170,105,0.75));
  }

  #gb-boot.show-logo #gb-logo-stage { opacity: 1; }

  #gb-boot.show-logo .gb-logo-main {
    animation: gb-logo-main-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-top {
    animation: gb-logo-top-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-middle {
    animation: gb-logo-middle-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-bottom {
    animation: gb-logo-bottom-v3 1700ms steps(1, end) both;
  }

  /* W czasie zaklocenia pelny obraz znika, a trzy wyciete pasy
     przesuwaja sie niezaleznie. Pozniej logo zostaje stabilne. */
  @keyframes gb-logo-main-v3 {
    0%   { opacity: 0; transform: translateX(-6px) scale(0.98); filter: blur(3px); }
    7%   { opacity: 1; transform: translateX(0) scale(1); filter: none; }
    23%  { opacity: 1; }
    24%  { opacity: 0; }
    40%  { opacity: 0; }
    41%  { opacity: 1; transform: translateX(2px); }
    44%  { transform: translateX(-2px); }
    47%  { transform: translateX(0); }
    100% { opacity: 1; transform: translateX(0) scale(1); filter: none; }
  }

  @keyframes gb-logo-top-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(-21px,-3px); }
    29% { opacity: 1; transform: translate(12px,1px); }
    34% { opacity: 1; transform: translate(-16px,-1px); }
    40% { opacity: 1; transform: translate(7px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  @keyframes gb-logo-middle-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(18px,2px); }
    29% { opacity: 1; transform: translate(-12px,-1px); }
    34% { opacity: 1; transform: translate(24px,1px); }
    40% { opacity: 1; transform: translate(-8px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  @keyframes gb-logo-bottom-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(-13px,3px); }
    29% { opacity: 1; transform: translate(22px,-2px); }
    34% { opacity: 1; transform: translate(-9px,1px); }
    40% { opacity: 1; transform: translate(15px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  /* ORBITA: prawdziwe dwa luki z oryginalnego logo, poczatkowo niewidoczne.
     Biala kreska w masce odkrywa zrodowe piksele orbity, nie rysuje nowej kropki. */
  .gb-orbit {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .gb-orbit-draw {
    fill: none;
    stroke: white;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 100;
  }

  .gb-orbit-upper { stroke-width: 25; }
  .gb-orbit-lower { stroke-width: 31; }

  /* Szybki rysunek orbity: dol od lewej do prawej, gora od prawej do lewej. */
  #gb-boot.show-logo .gb-orbit-lower {
    animation: gb-draw-orbit 180ms 420ms linear both;
  }

  #gb-boot.show-logo .gb-orbit-upper {
    animation: gb-draw-orbit 200ms 580ms linear both;
  }

  @keyframes gb-draw-orbit {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: 0; }
  }

  /* Zachowujemy dotychczasowe przejscie CRT. Dopracujemy je oddzielnie. */
  ::view-transition-old(root) {
    animation: gb-crt-out 85ms ease-in both !important;
  }

  ::view-transition-new(root) {
    animation: gb-crt-in 170ms ease-out both !important;
  }

  @keyframes gb-crt-out {
    from { opacity: 1; filter: brightness(1); }
    to { opacity: 0; filter: brightness(0.45); }
  }

  @keyframes gb-crt-in {
    0% { opacity: 0.65; clip-path: inset(49% 0 49% 0); filter: brightness(1.35); }
    45% { opacity: 1; clip-path: inset(0); filter: brightness(1.1); }
    100% { opacity: 1; clip-path: inset(0); filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gb-orbit-draw {
      animation: none !important;
      stroke-dashoffset: 0 !important;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.01ms !important;
    }

    #gb-boot { transition: none !important; }
  }
</style>

<script>
  let checkedBoot = false;

  document.addEventListener('astro:page-load', () => {
    // Astro ClientRouter fires this also on normal navigation.
    // Play the boot animation only once per tab.
    if (checkedBoot) return;
    checkedBoot = true;

    if (!document.documentElement.classList.contains('gb-boot-pending')) return;

    const boot = document.getElementById('gb-boot');
    const code = document.getElementById('gb-code');

    if (!boot || !code) {
      document.documentElement.classList.remove('gb-boot-pending');
      return;
    }

    try { sessionStorage.setItem('grzybol-boot-orbit-v2', '1'); } catch {}

    // Stylizowana sekwencja startowa, nie rzeczywisty firmware.
    const lines = [
      '// GRZYBOL9000 :: SYSTEM START',
      '#include "stm32l4xx_hal.h"',
      '#include "gnss.h"',
      'int main(void) {',
      '  HAL_Init();',
      '  SystemClock_Config();',
      '  Power_Enable_3V3();',
      '  GNSS_UART_Init();',
      '  Display_SPI_Init();',
      '  Navigation_Start();',
      '  while (1) { GNSS_Poll(); }',
      '}'
    ];

    let row = 0;
    code.textContent = '';

    const ticker = window.setInterval(() => {
      if (row < lines.length) {
        code.textContent += lines[row++] + '\n';
      } else {
        window.clearInterval(ticker);
      }
    }, 18);

    window.setTimeout(() => {
      window.clearInterval(ticker);
      boot.classList.add('show-logo');
    }, 270);

    window.setTimeout(() => {
      document.documentElement.classList.remove('gb-boot-pending');
    }, 2170);

    window.setTimeout(() => {
      boot.remove();
    }, 2490);
  });
</script>