---
const base = import.meta.env.BASE_URL;
---

<!-- Intro jest odtwarzane raz na karte, nie przy kazdej zmianie podstrony. -->
<script is:inline>
  try {
    const played = sessionStorage.getItem('grzybol-boot-v4') === '1';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!played && !reduced) {
      document.documentElement.classList.add('gb-boot-pending');
    }
  } catch {
    // Brak dostepu do pamieci sesji nie blokuje strony.
  }
</script>

<div id="gb-boot" aria-hidden="true">
  <pre id="gb-code"></pre>

  <div id="gb-logo-stage">
    <img class="gb-logo-main" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-top" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-middle" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-bottom" src={`${base}assets/grzybol-logo.png`} alt="" />
  </div>
</div>

<!-- Wygaszacz po 30 sekundach bez aktywnosci. Nie usuwa ani nie przeladowuje strony. -->
<div id="gb-idle-saver" aria-hidden="true">
  <div id="gb-idle-logo-stage">
    <img class="gb-logo-main" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-top" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-middle" src={`${base}assets/grzybol-logo.png`} alt="" />
    <img class="gb-logo-slice gb-slice-bottom" src={`${base}assets/grzybol-logo.png`} alt="" />
  </div>
</div>

<style is:global>
  html.gb-boot-pending { overflow: hidden; }

  #gb-boot {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #020503;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 280ms ease, visibility 280ms;
  }

  html.gb-boot-pending #gb-boot {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Biale linijki kodu, od samego lewego gornego rogu. */
  #gb-code {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 8px 10px;
    overflow: hidden;
    color: #f5f5f1;
    opacity: 0.94;
    white-space: pre;
    font: clamp(10px, 1vw, 14px)/1.4 'Courier New', monospace;
    letter-spacing: 0.2px;
    text-shadow: 0 0 4px rgba(255,255,255,0.18);
    transition: opacity 100ms linear, filter 100ms linear;
  }

  #gb-boot.show-logo #gb-code {
    opacity: 0;
    filter: blur(3px);
  }

  #gb-logo-stage {
    position: relative;
    isolation: isolate;
    width: min(470px, 78vw);
    max-height: 50vh;
    opacity: 0;
  }

  #gb-logo-stage img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  #gb-logo-stage .gb-logo-main { position: relative; }

  #gb-logo-stage .gb-logo-slice {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  #gb-logo-stage .gb-slice-top {
    clip-path: inset(0 0 67% 0);
    filter: drop-shadow(3px 0 1px rgba(183,220,177,0.85));
  }

  #gb-logo-stage .gb-slice-middle {
    clip-path: inset(33% 0 33% 0);
    filter: drop-shadow(-3px 0 1px rgba(246,247,245,0.95));
  }

  #gb-logo-stage .gb-slice-bottom {
    clip-path: inset(67% 0 0 0);
    filter: drop-shadow(4px 0 1px rgba(218,170,105,0.75));
  }

  #gb-boot.show-logo #gb-logo-stage { opacity: 1; }

  #gb-boot.show-logo .gb-logo-main {
    animation: gb-logo-main-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-top {
    animation: gb-logo-top-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-middle {
    animation: gb-logo-middle-v3 1700ms steps(1, end) both;
  }

  #gb-boot.show-logo .gb-slice-bottom {
    animation: gb-logo-bottom-v3 1700ms steps(1, end) both;
  }

  /* W czasie zaklocenia pelny obraz znika, a trzy wyciete pasy
     przesuwaja sie niezaleznie. Pozniej logo zostaje stabilne. */
  @keyframes gb-logo-main-v3 {
    0%   { opacity: 0; transform: translateX(-6px) scale(0.98); filter: blur(3px); }
    7%   { opacity: 1; transform: translateX(0) scale(1); filter: none; }
    23%  { opacity: 1; }
    24%  { opacity: 0; }
    40%  { opacity: 0; }
    41%  { opacity: 1; transform: translateX(2px); }
    44%  { transform: translateX(-2px); }
    47%  { transform: translateX(0); }
    100% { opacity: 1; transform: translateX(0) scale(1); filter: none; }
  }

  @keyframes gb-logo-top-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(-21px,-3px); }
    29% { opacity: 1; transform: translate(12px,1px); }
    34% { opacity: 1; transform: translate(-16px,-1px); }
    40% { opacity: 1; transform: translate(7px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  @keyframes gb-logo-middle-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(18px,2px); }
    29% { opacity: 1; transform: translate(-12px,-1px); }
    34% { opacity: 1; transform: translate(24px,1px); }
    40% { opacity: 1; transform: translate(-8px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  @keyframes gb-logo-bottom-v3 {
    0%, 23% { opacity: 0; transform: translate(0,0); }
    24% { opacity: 1; transform: translate(-13px,3px); }
    29% { opacity: 1; transform: translate(22px,-2px); }
    34% { opacity: 1; transform: translate(-9px,1px); }
    40% { opacity: 1; transform: translate(15px,0); }
    41%, 100% { opacity: 0; transform: translate(0,0); }
  }

  /* WYGASZACZ: czarne tlo i to samo rozjezdzajace sie logo co w intro. */
  html.gb-idle { overflow: hidden; }

  #gb-idle-saver {
    position: fixed;
    inset: 0;
    z-index: 11000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #020503;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  html.gb-idle #gb-idle-saver {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #gb-idle-logo-stage {
    position: relative;
    isolation: isolate;
    width: min(470px, 78vw);
    max-height: 50vh;
  }

  #gb-idle-logo-stage img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  #gb-idle-logo-stage .gb-logo-main { position: relative; }

  #gb-idle-logo-stage .gb-logo-slice {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  #gb-idle-logo-stage .gb-slice-top {
    clip-path: inset(0 0 67% 0);
    filter: drop-shadow(3px 0 1px rgba(183,220,177,0.85));
  }

  #gb-idle-logo-stage .gb-slice-middle {
    clip-path: inset(33% 0 33% 0);
    filter: drop-shadow(-3px 0 1px rgba(246,247,245,0.95));
  }

  #gb-idle-logo-stage .gb-slice-bottom {
    clip-path: inset(67% 0 0 0);
    filter: drop-shadow(4px 0 1px rgba(218,170,105,0.75));
  }

  #gb-idle-logo-stage.gb-idle-glitch .gb-logo-main {
    animation: gb-logo-main-v3 1700ms steps(1, end) both;
  }

  #gb-idle-logo-stage.gb-idle-glitch .gb-slice-top {
    animation: gb-logo-top-v3 1700ms steps(1, end) both;
  }

  #gb-idle-logo-stage.gb-idle-glitch .gb-slice-middle {
    animation: gb-logo-middle-v3 1700ms steps(1, end) both;
  }

  #gb-idle-logo-stage.gb-idle-glitch .gb-slice-bottom {
    animation: gb-logo-bottom-v3 1700ms steps(1, end) both;
  }

  /* Zachowujemy dotychczasowe przejscie CRT. Dopracujemy je oddzielnie. */
  ::view-transition-old(root) {
    animation: gb-crt-out 85ms ease-in both !important;
  }

  ::view-transition-new(root) {
    animation: gb-crt-in 170ms ease-out both !important;
  }

  @keyframes gb-crt-out {
    from { opacity: 1; filter: brightness(1); }
    to { opacity: 0; filter: brightness(0.45); }
  }

  @keyframes gb-crt-in {
    0% { opacity: 0.65; clip-path: inset(49% 0 49% 0); filter: brightness(1.35); }
    45% { opacity: 1; clip-path: inset(0); filter: brightness(1.1); }
    100% { opacity: 1; clip-path: inset(0); filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.01ms !important;
    }
    #gb-boot { transition: none !important; }
    #gb-idle-saver { transition: none !important; }
    #gb-idle-logo-stage.gb-idle-glitch .gb-logo-main,
    #gb-idle-logo-stage.gb-idle-glitch .gb-logo-slice {
      animation: none !important;
    }
    #gb-idle-logo-stage.gb-idle-glitch .gb-logo-slice {
      opacity: 0 !important;
    }
  }
</style>

<script>
  let checkedBoot = false;

  const IDLE_AFTER_MS = 30_000;
  let idleTimer: number | undefined;
  let idleGlitchTimer: number | undefined;
  let saverIsVisible = false;

  function stopIdleTimers() {
    window.clearTimeout(idleTimer);
    window.clearInterval(idleGlitchTimer);
    idleTimer = undefined;
    idleGlitchTimer = undefined;
  }

  function runIdleLogoGlitch() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const logo = document.getElementById('gb-idle-logo-stage');
    if (!logo) return;
    logo.classList.remove('gb-idle-glitch');
    void logo.offsetWidth; // uruchamia animacje od poczatku
    logo.classList.add('gb-idle-glitch');
  }

  function showIdleSaver() {
    if (document.hidden || document.documentElement.classList.contains('gb-boot-pending')) {
      return;
    }
    if (!document.getElementById('gb-idle-saver')) return;
    saverIsVisible = true;
    document.documentElement.classList.add('gb-idle');
    runIdleLogoGlitch();
    // Podczas dluzszej bezczynnosci co jakis czas powtarzamy efekt.
    idleGlitchTimer = window.setInterval(runIdleLogoGlitch, 8000);
  }

  function armIdleTimer() {
    window.clearTimeout(idleTimer);
    idleTimer = undefined;
    if (saverIsVisible || document.hidden ||
        document.documentElement.classList.contains('gb-boot-pending')) return;
    idleTimer = window.setTimeout(showIdleSaver, IDLE_AFTER_MS);
  }

  function hideIdleSaver() {
    saverIsVisible = false;
    window.clearInterval(idleGlitchTimer);
    idleGlitchTimer = undefined;
    document.documentElement.classList.remove('gb-idle');
    document.getElementById('gb-idle-logo-stage')?.classList.remove('gb-idle-glitch');
  }

  function handleActivity(event: Event) {
    if (saverIsVisible) {
      // Pierwsze przewiniecie lub klawisz tylko wybudza, nie rusza strony pod spodem.
      if (event.cancelable &&
          (event.type === 'wheel' || event.type === 'touchstart' || event.type === 'keydown')) {
        event.preventDefault();
      }
      hideIdleSaver();
    }
    armIdleTimer();
  }

  // Jeden zestaw sluchaczy dla calej aplikacji, rowniez przy zmianach podstron Astro.
  for (const type of ['pointermove', 'pointerdown']) {
    document.addEventListener(type, handleActivity, { passive: true, capture: true });
  }
  document.addEventListener('keydown', handleActivity, { passive: false, capture: true });
  document.addEventListener('wheel', handleActivity, { passive: false, capture: true });
  document.addEventListener('touchstart', handleActivity, { passive: false, capture: true });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopIdleTimers();
      if (saverIsVisible) hideIdleSaver();
    } else {
      armIdleTimer();
    }
  });

  document.addEventListener('astro:before-swap', () => {
    stopIdleTimers();
    if (saverIsVisible) hideIdleSaver();
  });

  document.addEventListener('astro:page-load', () => {
    // Przy zmianie zakladki resetujemy 30-sekundowe odliczanie.
    if (checkedBoot) {
      armIdleTimer();
      return;
    }
    checkedBoot = true;

    if (!document.documentElement.classList.contains('gb-boot-pending')) {
      armIdleTimer();
      return;
    }

    const boot = document.getElementById('gb-boot');
    const code = document.getElementById('gb-code');

    if (!boot || !code) {
      document.documentElement.classList.remove('gb-boot-pending');
      armIdleTimer();
      return;
    }

    try { sessionStorage.setItem('grzybol-boot-v4', '1'); } catch {}

    // To stylizowana sekwencja startowa, nie rzeczywisty firmware.
    const lines = [
      '// GRZYBOL9000 :: SYSTEM START',
      '#include "stm32l4xx_hal.h"',
      '#include "gnss.h"',
      'int main(void) {',
      '  HAL_Init();',
      '  SystemClock_Config();',
      '  Power_Enable_3V3();',
      '  GNSS_UART_Init();',
      '  Display_SPI_Init();',
      '  Navigation_Start();',
      '  while (1) { GNSS_Poll(); }',
      '}'
    ];

    let row = 0;
    code.textContent = '';

    const ticker = window.setInterval(() => {
      if (row < lines.length) {
        code.textContent += lines[row++] + '\n';
      } else {
        window.clearInterval(ticker);
      }
    }, 18);

    // Błyskawiczny start: kod przez ~0,27 s, potem logo przez ~1,9 s.
    window.setTimeout(() => {
      window.clearInterval(ticker);
      boot.classList.add('show-logo');
    }, 270);

    // Odsłaniamy stronę ok. 2,17 s od startu.
    window.setTimeout(() => {
      document.documentElement.classList.remove('gb-boot-pending');
    }, 2170);

    window.setTimeout(() => {
      boot.remove();
      armIdleTimer(); // 30 sekund liczymy od zakonczenia intro.
    }, 2490);
  });
</script>