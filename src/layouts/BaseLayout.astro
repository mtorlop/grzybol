
---
import Header from '../components/Header.astro';
import { ClientRouter } from 'astro:transitions';
import GrzybolEffects from '../components/GrzybolEffects.astro';

interface Props {
  title: string;
  description?: string;
  activePage: 'start' | 'projekt' | 'devlog' | 'roadmapa';
}

const {
  title,
  description = 'GRZYBOL - autorski projekt urządzenia GPS.',
  activePage
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pl">
  <head>
    <link
      rel="icon"
      type="image/png"
      href={`${base}assets/grzybol-favicon.png?v=2`}
    />
    <ClientRouter />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="theme-color" content="#0c130e" />
    <meta name="description" content={description} />

    <title>{title} | GRZYBOL</title>

    <link
      rel="icon"
      href={`${base}assets/grzybol-favicon.png`}
      type="image/png"
    />

    <link
      rel="stylesheet"
      href={`${base}style.css`}
    />

    <script
      is:inline
      src={`${base}script.js?v=2`}
      defer
    ></script>
  </head>

  <body>
    <GrzybolEffects />


    <div class="page">
      <div class="container">
        <Header activePage={activePage} />

        <slot />
      </div>
    </div>
  </body>
</html>





